---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Chevron from '../../components/Chevron.astro';
import site from '../../data/site.json';
import { allProducts } from '../../lib/format.js';
const pg = site.ui.pages.menu;
---
<Layout title={pg.title} description={pg.description}>
  <div class="mx-auto max-w-6xl px-4 pt-12">
    <h1 class="font-display text-maroon text-6xl">{pg.h1}</h1>
    <p class="mt-3 text-lg">{pg.intro_ar}</p>
  </div>
  <nav aria-label="أقسام المنيو" class="sticky top-0 z-30 bg-cream/95 border-b border-maroon/15 mt-8">
    <ul class="mx-auto max-w-6xl px-4 flex gap-2 overflow-x-auto py-3">
      {site.categories.map((c) => <li class="shrink-0"><a href={`#${c.slug}`} class="block border border-maroon/40 px-3 py-1 text-maroon font-semibold hover:bg-rose">{c.ar}</a></li>)}
    </ul>
  </nav>
  <div class="mx-auto max-w-6xl px-4">
    {site.categories.map((c) => {
      const products = allProducts.filter((p) => p.category === c.slug);
      return (
        <section id={c.slug} class="scroll-mt-20 py-12 border-b border-maroon/15">
          <h2 class="font-display text-maroon text-4xl">{c.ar}</h2>
          {c.sub_ar.length > 0 && <p class="mt-3 text-qahwa/80">{c.sub_ar.join(' · ')}</p>}
          {products.length > 0 &&
            <ul class="mt-6 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-5">
              {products.map((p) => <li><ProductCard p={p} /></li>)}
            </ul>}
          <a href={`/menu/${c.slug}`} class="mt-6 inline-block font-semibold text-maroon underline underline-offset-4">{site.ui.view_category_ar} {c.ar} <Chevron /></a>
        </section>
      );
    })}
  </div>
</Layout>
