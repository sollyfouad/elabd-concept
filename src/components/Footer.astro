---
import site from '../data/site.json';
import { ar } from '../lib/format.js';
const { ui, brand, contact } = site;
const social = [
  ['Facebook', contact.social.facebook],
  ['Instagram', contact.social.instagram],
  ['YouTube', contact.social.youtube],
];
---
<footer class="bg-maroon-deep text-cream mt-20">
  <div class="mx-auto max-w-6xl px-4 py-12 grid gap-8 md:grid-cols-3">
    <div>
      <p class="font-display text-3xl">{brand.name_ar}</p>
      <p class="mt-1 text-rose">{brand.tagline_ar} · منذ {ar(brand.since)}</p>
    </div>
    <div>
      <h2 class="font-semibold">{ui.hotline_label_ar}</h2>
      <a href={`tel:${contact.hotline}`} class="font-display text-4xl hover:text-rose">{ar(contact.hotline)}</a>
      <h2 class="font-semibold mt-4">{ui.hours_label_ar}</h2>
      <p class="text-rose">{contact.hours_ar}</p>
    </div>
    <div>
      <h2 class="font-semibold">{ui.follow_ar}</h2>
      <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-2">
        {social.map(([name, href]) => <li><a href={href} class="underline underline-offset-4 hover:text-rose" rel="noopener">{name}</a></li>)}
        <li><a href={contact.real_site} class="underline underline-offset-4 hover:text-rose" rel="noopener">{ui.real_site_ar}</a></li>
      </ul>
    </div>
  </div>
  <p class="border-t border-cream/15 py-4 px-4 text-center text-sm text-rose">{ui.concept_note_ar}</p>
</footer>
