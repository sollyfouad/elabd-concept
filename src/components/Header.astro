---
import site from '../data/site.json';
import { t, num, label } from '../lib/format.js';
import { localizeHref, normalizePath, stripLocale, alternates, otherLang } from '../lib/i18n.js';

const { lang } = Astro.props;
const path = normalizePath(stripLocale(Astro.url.pathname));
const isCurrent = (href) => (href === '/' ? path === '/' : path.startsWith(href));
const { ui, brand, contact } = site;
const other = otherLang(lang);
---
<header class="border-b border-maroon/15 bg-cream">
  <div class="mx-auto max-w-6xl px-4 flex items-center gap-4 py-3">
    <a href={localizeHref('/', lang)} class="shrink-0">
      <img src={brand.logo} alt={lang === 'ar' ? brand.name_ar : brand.name_en} width="56" height="56" class="size-14" />
    </a>
    <nav aria-label={t(ui, 'nav_label', lang)} class="hidden md:block flex-1">
      <ul class="flex gap-6">
        {ui.nav.map((l) => (
          <li><a href={localizeHref(l.href, lang)} aria-current={isCurrent(l.href) ? 'page' : undefined}
            class="py-2 font-semibold text-qahwa hover:text-maroon aria-[current=page]:text-maroon aria-[current=page]:underline underline-offset-8 decoration-2">{label(l, lang)}</a></li>
        ))}
      </ul>
    </nav>
    <a href={`tel:${contact.hotline}`} class="ms-auto md:ms-0 bg-maroon text-cream font-semibold px-4 py-2 hover:bg-maroon-deep transition-colors">
      {t(ui, 'order', lang)} {num(contact.hotline, lang)}
    </a>
    <a href={alternates(Astro.url.pathname)[other]} hreflang={other} lang={other}
       data-lang-switch class="min-h-11 flex items-center py-2 font-semibold text-qahwa hover:text-maroon">{t(ui, 'lang_switch', lang)}</a>
    <!-- ponytail: native <details> menu, no JS -->
    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer p-2 font-semibold text-maroon [&::-webkit-details-marker]:hidden">{t(ui, 'menu_toggle', lang)} ☰</summary>
      <nav aria-label={t(ui, 'nav_label', lang)} class="absolute end-0 top-full mt-2 z-40 w-56 bg-cream border border-maroon/20">
        <ul>
          {ui.nav.map((l) => (
            <li><a href={localizeHref(l.href, lang)} aria-current={isCurrent(l.href) ? 'page' : undefined}
              class="block px-4 py-3 font-semibold hover:bg-rose aria-[current=page]:text-maroon">{label(l, lang)}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
