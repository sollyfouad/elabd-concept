---
import site from '../data/site.json';
import { ar } from '../lib/format.js';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href) => (href === '/' ? path === '/' : path.startsWith(href));
const { ui, brand, contact } = site;
---
<header class="border-b border-maroon/15 bg-cream">
  <div class="mx-auto max-w-6xl px-4 flex items-center gap-4 py-3">
    <a href="/" class="shrink-0">
      <img src={brand.logo} alt={brand.name_ar} width="56" height="56" class="size-14" />
    </a>
    <nav aria-label="الرئيسية" class="hidden md:block flex-1">
      <ul class="flex gap-6">
        {ui.nav.map((l) => (
          <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}
            class="py-2 font-semibold text-qahwa hover:text-maroon aria-[current=page]:text-maroon aria-[current=page]:underline underline-offset-8 decoration-2">{l.ar}</a></li>
        ))}
      </ul>
    </nav>
    <a href={`tel:${contact.hotline}`} class="ms-auto md:ms-0 bg-maroon text-cream font-semibold px-4 py-2 hover:bg-maroon-deep transition-colors">
      {ui.order_ar} {ar(contact.hotline)}
    </a>
    <!-- ponytail: native <details> menu, no JS -->
    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer p-2 font-semibold text-maroon [&::-webkit-details-marker]:hidden">{ui.menu_toggle_ar} ☰</summary>
      <nav aria-label="الرئيسية" class="absolute end-0 top-full mt-2 z-40 w-56 bg-cream border border-maroon/20">
        <ul>
          {ui.nav.map((l) => (
            <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}
              class="block px-4 py-3 font-semibold hover:bg-rose aria-[current=page]:text-maroon">{l.ar}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
