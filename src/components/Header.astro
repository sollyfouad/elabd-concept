---
import site from '../data/site.json';
import { t, num, label } from '../lib/format.js';
import { localizeHref, normalizePath, stripLocale, alternates, otherLang } from '../lib/i18n.js';

const { lang } = Astro.props;
const path = normalizePath(stripLocale(Astro.url.pathname));
const isCurrent = (href) => (href === '/' ? path === '/' : path.startsWith(href));
const { ui, brand, contact } = site;
const other = otherLang(lang);
const store = ui.store;
---
<!-- Phones: sticky, one line (logo, call, language, menu). md+: the original static desktop header. -->
<header class="sticky top-0 z-50 md:static border-b border-maroon/15 bg-cream">
  <div class="mx-auto max-w-6xl px-4 flex items-center gap-1 md:gap-4 py-1.5 md:py-3 whitespace-nowrap">
    <a href={localizeHref('/', lang)} class="shrink-0 flex items-center justify-center min-h-11 min-w-11">
      <img src={brand.logo} alt={lang === 'ar' ? brand.name_ar : brand.name_en} width="56" height="56" class="size-10 md:size-14" />
    </a>
    <nav aria-label={t(ui, 'nav_label', lang)} class="hidden md:block flex-1">
      <ul class="flex gap-6">
        {ui.nav.map((l) => (
          <li><a href={localizeHref(l.href, lang)} aria-current={isCurrent(l.href) ? 'page' : undefined}
            class="flex items-center min-h-11 font-semibold text-qahwa hover:text-maroon aria-[current=page]:text-maroon aria-[current=page]:underline underline-offset-8 decoration-2">{label(l, lang)}</a></li>
        ))}
      </ul>
    </nav>
    <!-- icon-only call link up to lg: at md the nav + search + cart leave no room for the "Order on 17111" pill -->
    <a href={`tel:${contact.hotline}`} aria-label={`${t(ui, 'call', lang)} ${num(contact.hotline, lang)}`}
       class="lg:hidden ms-auto flex items-center gap-1.5 min-h-11 min-w-11 justify-center px-2 font-semibold text-maroon">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 shrink-0" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
      <span class="hidden sm:inline md:hidden">{num(contact.hotline, lang)}</span>
    </a>
    <a href={`tel:${contact.hotline}`} class="hidden lg:flex items-center min-h-11 bg-maroon text-cream font-semibold px-4 py-2 hover:bg-maroon-deep transition-colors">
      {t(ui, 'order', lang)} {num(contact.hotline, lang)}
    </a>
    <!-- header search: native <details>, filters client-side on /search only -->
    <!-- below sm the panel anchors to the sticky header (full width, 16px gutters) so it can't run off-screen -->
    <details name="header-panel" class="sm:relative">
      <summary aria-label={t(store, 'search_toggle', lang)} class="list-none cursor-pointer grid place-items-center min-h-11 min-w-11 text-maroon [&::-webkit-details-marker]:hidden">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4.3-4.3" /></svg>
      </summary>
      <div class="absolute inset-x-4 top-full mt-2 z-40 sm:inset-x-auto sm:end-0 sm:w-80 bg-cream border border-maroon/20 p-3">
        <form role="search" action={localizeHref('/search', lang)} method="get" class="flex items-end gap-2">
          <div class="flex-1">
            <label for="hdr-q" class="block text-sm font-semibold">{t(store, 'search_label', lang)}</label>
            <input id="hdr-q" type="search" name="q" autocomplete="off" class="min-h-11 w-full border border-maroon/30 px-2 mt-1" />
          </div>
          <button type="submit" class="flex items-center min-h-11 px-3 bg-maroon text-cream font-semibold hover:bg-maroon-deep">{t(store, 'search_submit', lang)}</button>
        </form>
      </div>
    </details>
    <a href={localizeHref('/cart', lang)} class="relative grid place-items-center min-h-11 min-w-11 text-maroon">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1" /><circle cx="18" cy="20" r="1" /><path d="M3 4h2l2.4 12.1a1 1 0 0 0 1 .9h9.2a1 1 0 0 0 1-.8L20 8H6" /></svg>
      <span class="sr-only" data-cart-count-label data-template={t(store, 'cart_count', lang)}>{t(store, 'cart_label', lang)}</span>
      <span data-cart-count aria-hidden="true" hidden class="absolute top-0.5 end-0 min-w-5 h-5 px-1 grid place-items-center rounded-full bg-maroon text-cream text-xs font-semibold"></span>
    </a>
    <a href={alternates(Astro.url.pathname)[other]} hreflang={other} lang={other}
       data-lang-switch class="min-h-11 min-w-11 flex items-center justify-center px-2 md:px-0 py-2 font-semibold text-qahwa hover:text-maroon">{t(ui, 'lang_switch', lang)}</a>
    <!-- ponytail: native <details> menu, no JS -->
    <details name="header-panel" class="md:hidden relative">
      <summary aria-label={t(ui, 'menu_toggle', lang)} class="list-none cursor-pointer grid place-items-center min-h-11 min-w-11 text-maroon [&::-webkit-details-marker]:hidden">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </summary>
      <nav aria-label={t(ui, 'nav_label', lang)} class="absolute end-0 top-full mt-2 z-40 w-56 bg-cream border border-maroon/20">
        <ul>
          {ui.nav.map((l) => (
            <li><a href={localizeHref(l.href, lang)} aria-current={isCurrent(l.href) ? 'page' : undefined}
              class="flex items-center min-h-11 px-4 py-2 font-semibold hover:bg-rose aria-[current=page]:text-maroon">{label(l, lang)}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
