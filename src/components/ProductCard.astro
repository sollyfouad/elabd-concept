---
import site from '../data/site.json';
import { t, num, price, label } from '../lib/format.js';
const { p, lang } = Astro.props;
// TODO: site.json has no per-product URLs on elabdfoods.com, so "order" goes to the hotline.
---
<article class="flex flex-col h-full border-b-2 border-maroon/20 pb-3">
  <div class="bg-rose aspect-square">
    <img src={p.img} alt={label(p, lang)} loading="lazy" width="415" height="415" class="size-full object-contain mix-blend-multiply" />
  </div>
  <h3 class="mt-3 font-semibold leading-snug">{label(p, lang)}</h3>
  <p class="mt-1 text-maroon font-semibold">{price(p.price, p.price_to, lang)}</p>
  <a href={`tel:${site.contact.hotline}`} class="mt-auto pt-2 text-sm font-semibold text-maroon underline underline-offset-4 hover:text-maroon-deep">
    {t(site.ui, 'order', lang)} {num(site.contact.hotline, lang)}
  </a>
</article>
