---
import site from '../data/site.json';
import { t, price, label, productHref } from '../lib/format.js';
// wide: the card spans two grid columns below lg, so its photo well goes 2:1 to keep row heights even.
const { p, lang, float = false, wide = false } = Astro.props;
// The sr-only product name makes the add-to-cart button unique in a screen reader's button list.
const store = site.ui.store;
---
<article class="relative flex flex-col h-full border-b-2 border-maroon/20 pb-3">
  <div class:list={["bg-rose", wide ? "aspect-[2/1] overflow-hidden lg:aspect-square" : "aspect-square"]}>
    <img src={p.img} alt={label(p, lang)} loading="lazy" width="415" height="415" class:list={["size-full object-contain mix-blend-multiply", { "m-float": float }]} />
  </div>
  <h3 class="mt-3 font-semibold leading-snug"><a href={productHref(p, lang)} class="flex items-center min-h-11 after:absolute after:inset-0">{label(p, lang)}</a></h3>
  <p class="mt-1 text-maroon font-semibold">{price(p.price, p.price_to, lang)}</p>
  <button type="button" data-add-to-cart={p.slug} data-name={label(p, lang)} data-added-template={t(store, 'added', lang)} data-added-label={t(store, 'added_short', lang)}
    class="relative z-10 mt-auto flex items-center justify-center min-h-11 px-3 font-semibold bg-maroon text-cream hover:bg-maroon-deep hover:text-cream">
    <span data-btn-label>{t(store, 'add_to_cart', lang)}</span><span class="sr-only">{t(site.ui, 'list_sep', lang)}{label(p, lang)}</span>
  </button>
</article>
