---
import site from '../data/site.json';
import { t, num, price, label } from '../lib/format.js';
// wide: the card spans two grid columns below lg, so its photo well goes 2:1 to keep row heights even.
const { p, lang, float = false, wide = false } = Astro.props;
// The sr-only product name makes each order link unique in a screen reader's link list.
// TODO: site.json has no per-product URLs on elabdfoods.com, so "order" goes to the hotline.
---
<article class="relative flex flex-col h-full border-b-2 border-maroon/20 pb-3">
  <div class:list={["bg-rose", wide ? "aspect-[2/1] overflow-hidden lg:aspect-square" : "aspect-square"]}>
    <img src={p.img} alt={label(p, lang)} loading="lazy" width="415" height="415" class:list={["size-full object-contain mix-blend-multiply", { "m-float": float }]} />
  </div>
  <h3 class="mt-3 font-semibold leading-snug">{label(p, lang)}</h3>
  <p class="mt-1 text-maroon font-semibold">{price(p.price, p.price_to, lang)}</p>
  <a href={`tel:${site.contact.hotline}`} class="mt-auto pt-2 flex items-center min-h-11 text-sm font-semibold text-maroon underline underline-offset-4 hover:text-maroon-deep">
    {t(site.ui, 'order', lang)} {num(site.contact.hotline, lang)}<span class="sr-only">{t(site.ui, 'list_sep', lang)}{label(p, lang)}</span>
  </a>
</article>
