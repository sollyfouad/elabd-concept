---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import site from '../../data/site.json';
import { t, num } from '../../lib/format.js';
// TODO: only Mouled has content in site.json; Eid kahk and Ramadan yamish collections need data.
const { lang } = Astro.props;
const season = site.seasonal[site.seasonal.active];
const pg = site.ui.pages.seasonal;
const { ui, contact } = site;
---
<Layout title={t(pg, 'title', lang)} description={t(pg, 'description', lang)} lang={lang} cart>
  <div class="bg-maroon-deep text-cream">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h1 class="font-display text-6xl md:text-7xl">{t(season, 'title', lang)}</h1>
      <p class="mt-4 max-w-xl text-lg text-rose">{t(pg, 'intro', lang)}</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {t(season, 'subcategories', lang).map((s) => <li class="border border-rose/50 text-rose px-3 py-1">{s}</li>)}
      </ul>
      <a href={`tel:${contact.hotline}`} class="mt-8 inline-flex items-center min-h-11 bg-rose text-maroon-deep font-semibold text-lg px-6 py-3 hover:bg-cream transition-colors">{t(ui, 'order', lang)} {num(contact.hotline, lang)}</a>
    </div>
  </div>
  <section class="mx-auto max-w-6xl px-4 py-14" aria-label={t(season, 'title', lang)}>
    <!-- Same no-orphan grid as the home Mouled band: first card spans 2 columns below lg. -->
    <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6">
      {season.products.map((p, i) => <li class:list={{ "col-span-2 lg:col-span-1": i === 0 }}><ProductCard p={p} lang={lang} wide={i === 0} /></li>)}
    </ul>
  </section>
</Layout>
