---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import site from '../../data/site.json';
import { num, allProducts, t, label } from '../../lib/format.js';
import { localizeHref } from '../../lib/i18n.js';

const { lang, c } = Astro.props;
const { ui, contact } = site;
const pgc = ui.pages.category;
const products = allProducts.filter((p) => p.category === c.slug);
const subs = t(c, 'sub', lang);
const desc = `${t(pgc, 'description_prefix', lang)} ${label(c, lang)} ${t(pgc, 'description_from', lang)}${subs.length ? `: ${subs.join(t(ui, 'list_sep', lang))}` : ''}.`;
---
<Layout title={`${label(c, lang)} ${t(pgc, 'title_suffix', lang)}`} description={desc} lang={lang}>
  <div class="mx-auto max-w-6xl px-4 pt-12">
    <nav aria-label={t(ui, 'breadcrumb_label', lang)} class="text-sm"><a href={localizeHref('/menu', lang)} class="text-maroon underline underline-offset-4">{t(ui.pages.menu, 'h1', lang)}</a> / <span aria-current="page">{label(c, lang)}</span></nav>
    <h1 class="mt-3 font-display text-maroon text-6xl">{label(c, lang)}</h1>
    {subs.length > 0 &&
      <ul class="mt-6 flex flex-wrap gap-2">
        {subs.map((s) => <li class="bg-rose text-maroon px-3 py-1 font-semibold">{s}</li>)}
      </ul>}
    {products.length > 0
      ? <ul class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">{products.map((p) => <li><ProductCard p={p} lang={lang} /></li>)}</ul>
      : <p class="mt-10 text-lg">{/* TODO: no products for this category in site.json */}{t(ui, 'no_products', lang)} <a href={`tel:${contact.hotline}`} class="font-semibold text-maroon underline underline-offset-4">{num(contact.hotline, lang)}</a></p>}
  </div>
</Layout>
