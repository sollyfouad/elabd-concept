---
import Layout from '../../layouts/Layout.astro';
import site from '../../data/site.json';
import { t, num, label, productHref, storeProducts } from '../../lib/format.js';
import { localizeHref } from '../../lib/i18n.js';

const { lang } = Astro.props;
const { ui, contact } = site;
const store = ui.store;
const pg = ui.pages.checkout;
const branches = t(site, 'branches', lang);

const catalog = Object.fromEntries(storeProducts.map((p) => [p.slug, {
  name: label(p, lang),
  price: p.price,
  ...(p.price_to != null ? { price_to: p.price_to } : {}),
  img: p.img,
  href: productHref(p, lang),
}]));

// Only the few UI strings/lists checkout.js needs, so the client bundle doesn't import all of
// site.json.
const strings = {
  currency: site[`currency_${lang}`],
  from: t(store, 'from', lang),
  total: t(store, 'total', lang),
  error_name: t(store, 'error_name', lang),
  error_phone: t(store, 'error_phone', lang),
  error_payment: t(store, 'error_payment', lang),
  error_method: t(store, 'error_method', lang),
  error_address: t(store, 'error_address', lang),
  error_area: t(store, 'error_area', lang),
  error_time: t(store, 'error_time', lang),
  step_time: t(store, 'step_time', lang),
  step_time_pickup: t(store, 'step_time_pickup', lang),
  method_delivery: t(store, 'method_delivery', lang),
  method_pickup: t(store, 'method_pickup', lang),
  ...Object.fromEntries(['sum_name', 'sum_phone', 'sum_method', 'sum_address', 'sum_branch', 'sum_time', 'sum_payment', 'order_no', 'item_count'].map((k) => [k, t(store, k, lang)])),
  delivery_fee: t(store, 'delivery_fee', lang),
  branches,
  slots: t(store, 'slots', lang),
  payments: t(store, 'payments', lang),
};

const radioRow = 'flex items-center gap-3 min-h-11';
const textInput = 'min-h-11 w-full border border-maroon/30 px-2 mt-1';
---
<Layout title={t(pg, 'title', lang)} description={t(pg, 'description', lang)} lang={lang} cart catalog={catalog}>
  <div class="mx-auto max-w-2xl px-4 pt-12 pb-20">
    <h1 class="font-display text-maroon text-6xl">{t(pg, 'h1', lang)}</h1>

    <noscript>
      <p class="mt-4">{t(ui, 'order', lang)} <a href={`tel:${contact.hotline}`} class="inline-flex items-center min-h-11 font-semibold text-maroon underline underline-offset-4">{num(contact.hotline, lang)}</a></p>
    </noscript>

    <div data-checkout-empty hidden class="mt-10">
      <p class="text-lg">{t(store, 'empty', lang)}</p>
      <a href={localizeHref('/menu', lang)} class="mt-3 inline-flex items-center min-h-11 font-semibold text-maroon underline underline-offset-4">{t(store, 'continue', lang)}</a>
    </div>

    <ol aria-label={t(store, 'steps_label', lang)} class="mt-6 flex gap-4 text-sm font-semibold">
      <li data-step-indicator="1" aria-current="step">{num(1, lang)}. {t(store, 'step_area', lang)}</li>
      <li data-step-indicator="2">{num(2, lang)}. {t(store, 'step_pay_time', lang)}</li>
      <li data-step-indicator="3">{num(3, lang)}. {t(store, 'step_summary', lang)}</li>
    </ol>

    <section data-step="1" data-step-section class="mt-8">
      <h2 tabindex="-1" class="font-display text-maroon text-3xl">{t(store, 'step_area', lang)}</h2>

      {/* Name and phone: no name attribute and no form, so nothing can serialise or submit them;
          checkout.js only reads them to echo them back and clears them on confirm. */}
      <fieldset id="contact-fieldset" class="mt-4">
        <legend class="font-semibold">{t(store, 'contact_legend', lang)}</legend>
        <div class="grid gap-3">
          <div>
            <label for="cust-name" class="block font-semibold">{t(store, 'cust_name', lang)}</label>
            <input id="cust-name" type="text" autocomplete="off" class={textInput} />
          </div>
          <div>
            <label for="cust-phone" class="block font-semibold">{t(store, 'cust_phone', lang)}</label>
            <input id="cust-phone" type="text" inputmode="tel" dir="ltr" autocomplete="off" class={textInput} />
          </div>
        </div>
        <p class="mt-2 text-sm">{t(store, 'contact_note', lang)}</p>
        <p id="contact-error" role="alert" hidden class="text-maroon-deep font-semibold"></p>
      </fieldset>

      <fieldset id="method-fieldset" class="mt-6">
        <legend class="font-semibold">{t(store, 'method_legend', lang)}</legend>
        <label class={radioRow}><input type="radio" name="method" value="delivery" id="method-delivery" /> {t(store, 'method_delivery', lang)}</label>
        <label class={radioRow}><input type="radio" name="method" value="pickup" id="method-pickup" /> {t(store, 'method_pickup', lang)}</label>
        <p id="method-error" role="alert" hidden class="text-maroon-deep font-semibold"></p>
      </fieldset>

      <fieldset data-method-panel="delivery" id="delivery-fieldset" hidden class="mt-4">
        <legend class="sr-only">{t(store, 'method_delivery', lang)}</legend>
        <div class="grid gap-3">
          <div>
            <label for="addr-area" class="block font-semibold">{t(store, 'addr_area', lang)}</label>
            <input id="addr-area" type="text" autocomplete="off" class={textInput} />
          </div>
          <div>
            <label for="addr-street" class="block font-semibold">{t(store, 'addr_street', lang)}</label>
            <input id="addr-street" type="text" autocomplete="off" class={textInput} />
          </div>
          <div>
            <label for="addr-building" class="block font-semibold">{t(store, 'addr_building', lang)}</label>
            <input id="addr-building" type="text" autocomplete="off" class={textInput} />
          </div>
          <div>
            <label for="addr-landmark" class="block font-semibold">{t(store, 'addr_landmark', lang)}</label>
            <input id="addr-landmark" type="text" autocomplete="off" class={textInput} />
          </div>
        </div>
        <p class="mt-2 text-sm">{t(store, 'address_note', lang)}</p>
        <p id="address-error" role="alert" hidden class="text-maroon-deep font-semibold"></p>
      </fieldset>

      <fieldset data-method-panel="pickup" id="pickup-fieldset" hidden class="mt-4">
        <legend class="font-semibold">{t(store, 'area_legend', lang)}</legend>
        {branches.map((b, i) => (
          <label class={radioRow}><input type="radio" name="branch" value={i} id={`branch-${i}`} /> {b}</label>
        ))}
        <p id="branch-error" role="alert" hidden class="text-maroon-deep font-semibold"></p>
      </fieldset>

      <button type="button" data-next class="mt-6 flex items-center min-h-11 px-6 bg-maroon text-cream font-semibold hover:bg-maroon-deep">{t(store, 'next', lang)}</button>
    </section>

    <section data-step="2" data-step-section hidden class="mt-8">
      <h2 tabindex="-1" class="font-display text-maroon text-3xl">{t(store, 'step_pay_time', lang)}</h2>
      <fieldset id="slot-fieldset" class="mt-4">
        <legend id="slot-legend" class="font-semibold">{t(store, 'step_time', lang)}</legend>
        {t(store, 'slots', lang).map((s, i) => (
          <label class={radioRow}><input type="radio" name="slot" value={i} id={`slot-${i}`} /> {s}</label>
        ))}
        <p id="slot-error" role="alert" hidden class="text-maroon-deep font-semibold"></p>
      </fieldset>
      {/* Payment is a choice only: no card number, expiry or CVV fields. */}
      <fieldset id="payment-fieldset" class="mt-6">
        <legend class="font-semibold">{t(store, 'payment_legend', lang)}</legend>
        {t(store, 'payments', lang).map((pay, i) => (
          <label class={radioRow}><input type="radio" name="payment" value={i} id={`payment-${i}`} /> {pay}</label>
        ))}
        <p id="payment-error" role="alert" hidden class="text-maroon-deep font-semibold"></p>
      </fieldset>
      <div class="mt-6 flex gap-3">
        <button type="button" data-back class="flex items-center min-h-11 px-6 border-2 border-maroon text-maroon font-semibold hover:bg-rose">{t(store, 'back', lang)}</button>
        <button type="button" data-next class="flex items-center min-h-11 px-6 bg-maroon text-cream font-semibold hover:bg-maroon-deep">{t(store, 'next', lang)}</button>
      </div>
    </section>

    <section data-step="3" data-step-section hidden class="mt-8">
      <h2 tabindex="-1" class="font-display text-maroon text-3xl">{t(store, 'step_summary', lang)}</h2>
      <ul data-summary-lines class="mt-4 divide-y divide-maroon/15"></ul>
      <p data-summary-total class="mt-4 font-semibold text-lg"></p>
      <p data-summary-fee hidden class="mt-1"></p>
      <dl data-summary-details class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1"></dl>
      <div class="mt-6 flex flex-wrap gap-3">
        <button type="button" data-back class="flex items-center min-h-11 px-6 border-2 border-maroon text-maroon font-semibold hover:bg-rose">{t(store, 'back', lang)}</button>
        <button type="button" data-edit-details class="flex items-center min-h-11 px-6 border-2 border-maroon text-maroon font-semibold hover:bg-rose">{t(store, 'edit_details', lang)}</button>
        <button type="button" data-confirm class="flex items-center min-h-11 px-6 bg-maroon text-cream font-semibold hover:bg-maroon-deep">{t(store, 'confirm', lang)}</button>
      </div>
      <div data-concept-notice class="mt-8 bg-rose p-4">
        <p>{t(store, 'concept_order', lang)}</p>
        <p class="mt-2 flex flex-wrap gap-4">
          <a href={contact.real_site} class="inline-flex items-center min-h-11 font-semibold text-maroon underline underline-offset-4">{t(ui, 'real_site', lang)}</a>
          <a href={`tel:${contact.hotline}`} class="inline-flex items-center min-h-11 font-semibold text-maroon underline underline-offset-4">{num(contact.hotline, lang)}</a>
        </p>
      </div>
    </section>

    <section data-confirmed hidden class="mt-8">
      <h2 tabindex="-1" class="font-display text-maroon text-3xl">{t(store, 'confirmed_h', lang)}</h2>
      <dl data-confirmed-details class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1"></dl>
      <div class="mt-4 bg-rose p-4">
        <p>{t(store, 'confirmed_body', lang)}</p>
        <p class="mt-2 flex flex-wrap gap-4">
          <a href={contact.real_site} class="inline-flex items-center min-h-11 font-semibold text-maroon underline underline-offset-4">{t(ui, 'real_site', lang)}</a>
          <a href={`tel:${contact.hotline}`} class="inline-flex items-center min-h-11 font-semibold text-maroon underline underline-offset-4">{num(contact.hotline, lang)}</a>
        </p>
      </div>
      <a href={localizeHref('/menu', lang)} class="mt-6 inline-flex items-center min-h-11 font-semibold text-maroon underline underline-offset-4">{t(store, 'continue', lang)}</a>
    </section>
  </div>
  <script type="application/json" id="checkout-strings" set:html={JSON.stringify(strings)} />
  <script>import '../../scripts/checkout.js';</script>
</Layout>
