---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Chevron from '../../components/Chevron.astro';
import site from '../../data/site.json';
import { t, num, price, label, allProducts, mapUrl } from '../../lib/format.js';
import { localizeHref } from '../../lib/i18n.js';

const { lang } = Astro.props;
const { ui, brand, contact } = site;
const h = ui.home;
const season = site.seasonal[site.seasonal.active];
// Ribbon facts: all real, all from site.json. Repeated so each copy is wider than any screen,
// then rendered twice so the marquee loops seamlessly at -50%.
const ribbon = [
  t(brand, 'tagline', lang),
  t(h, 'since', lang).replace('{year}', num(brand.since, lang)),
  t(h, 'branches_count', lang).replace('{n}', num(site.branches_ar.length, lang)),
  t(h, 'fresh', lang),
  t(contact, 'hours', lang),
  `${t(ui, 'hotline_label', lang)} ${num(contact.hotline, lang)}`,
].map((x) => `${x} · `).join('').repeat(2);
const [wordStart, wordEnd] = t(h, 'wordmark', lang);
// Type scale: the h1 is always the largest text in the hero; the decorative tagline sits one step
// below it at every width (phones by vw, md+ by clamp). English words are longer, so they scale smaller.
const wordmark = ['font-display text-maroon leading-[0.95] md:text-[clamp(3.5rem,6vw,6.5rem)]', lang === 'en' ? 'text-[8.5vw]' : 'text-[11vw]'];
const h1Size = lang === 'en' ? 'text-[10vw]' : 'text-[12.5vw]';
// The hours are the hotline/order hours (listed beside 17111 on elabdfoods.com), so the badge says so.
const orderHours = t(h, 'order_hours', lang).replace('{hours}', t(contact, 'hours', lang));
const openStatus = {
  'data-open-status': '',
  'data-hours': JSON.stringify(contact.open_hours),
  'data-open': t(h, 'open_now', lang),
  'data-closed': t(h, 'closed_now', lang),
  'data-time': t(h, 'cairo_time', lang),
};
// Categories without their own photo borrow the first product photo in that category.
const productImg = (slug) => allProducts.find((p) => p.category === slug)?.img;
const heroProduct = season.products.find((p) => p.hero_photo);
if (!heroProduct) throw new Error('HomeView: no seasonal product has hero_photo: true');
// Cheapest Mouled box, stated upfront. A box is a product with a piece count (same rule as the
// product page's "What's in the box").
const boxPrices = season.products.filter((p) => p.pieces).map((p) => p.price);
if (!boxPrices.length) throw new Error('HomeView: the active season has no boxes to quote a price for');
const boxesFrom = t(h, 'boxes_from', lang).replace('{price}', price(Math.min(...boxPrices), null, lang));
---
<Layout title={t(ui.pages.home, 'title', lang)} description={t(ui.pages.home, 'description', lang)} lang={lang} jsonLd cart>
  <!-- Scroll progress: a thin maroon ribbon down the inline-end edge (only where scroll timelines exist). -->
  <div aria-hidden="true" class="m-progress"></div>

  <!-- Hero: the pink box lid. The brand's tagline is split in giant Ruqaa around the real Mouled box;
       on scroll the words part and the box lifts (the lid opening). Ribbon of real facts below. -->
  <section data-hero class="relative overflow-x-clip bg-rose">
    <div aria-hidden="true" class="grain absolute inset-0 pointer-events-none"></div>
    <div class="relative mx-auto max-w-6xl px-4 pt-3 pb-24 md:pt-6 md:pb-36">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-x-4 text-xs md:text-sm font-semibold text-maroon">
        <p>{t(h, 'intro_short', lang)}</p>
        <p {...openStatus} class="whitespace-nowrap">
          <span aria-hidden="true" class="open-dot inline-block align-middle size-2 me-1.5 rounded-full bg-maroon"></span>
          <span data-open-text>{orderHours}</span>
        </p>
      </div>

      <!-- The split tagline and the box are one link to the Mouled collection. Its name starts with the
           visible tagline (label-in-name), then says where it goes. -->
      <a href={localizeHref('/seasonal', lang)} aria-label={`${t(brand, 'tagline', lang)}: ${t(h, 'seasonal_cta', lang)}`}
        class="group min-h-11 mt-3 md:mt-4 grid grid-cols-2 md:grid-cols-[1fr_auto_1fr] items-end md:items-center gap-x-3 md:gap-x-8">
        <span class:list={["m-part-start block col-start-1 row-start-1 justify-self-end text-end group-hover:text-maroon-deep transition-colors", wordmark]}>{wordStart}</span>
        <!-- The CDN original is 810px, so the photo is capped at 405px wide to stay 2x-sharp on retina.
             The shot has a white background, so it sits on a round white plate instead of being
             multiplied into the pink (which tinted and faded the box). -->
        <img data-hero-photo src={heroProduct.img} srcset={`${heroProduct.img} 415w, ${heroProduct.img_large} 810w`}
          sizes="(min-width: 768px) 384px, (min-width: 640px) 256px, 160px"
          alt={label(heroProduct, lang)} width="810" height="810" fetchpriority="high" decoding="async"
          class="m-lift col-span-2 row-start-2 md:col-span-1 md:col-start-2 md:row-start-1 justify-self-center w-40 sm:w-64 md:w-[clamp(16rem,27vw,24rem)] aspect-square object-contain rounded-full bg-white p-3 md:p-6 ring-1 ring-maroon/15 group-hover:ring-2 group-hover:ring-maroon/40" />
        <span class:list={["m-part-end block col-start-2 row-start-1 md:col-start-3 justify-self-start text-start group-hover:text-maroon-deep transition-colors", wordmark]}>{wordEnd}</span>
      </a>
      <p class="mt-2 text-center font-semibold text-maroon whitespace-nowrap">{boxesFrom}</p>

      <div class="mt-3 md:mt-6 grid gap-4 md:gap-10 md:grid-cols-[3fr_2fr] md:items-start">
        <h1 class:list={["font-display text-maroon leading-[1.15] md:text-[clamp(4rem,7vw,7.5rem)]", h1Size]}>{t(brand, 'hero', lang)}</h1>
        <div class="md:pt-3">
          <p class="hidden md:block text-lg">{t(h, 'intro', lang)}</p>
          <div class="md:mt-6 flex flex-wrap gap-3">
            <a href={`tel:${contact.hotline}`} class="inline-flex items-center min-h-11 bg-maroon text-cream font-semibold md:text-lg px-4 py-2.5 md:px-6 md:py-3 hover:bg-maroon-deep transition-colors">{t(ui, 'order', lang)} {num(contact.hotline, lang)}</a>
            <a href={localizeHref('/menu', lang)} class="inline-flex items-center min-h-11 border-2 border-maroon text-maroon font-semibold md:text-lg px-4 py-2 md:px-6 md:py-3 hover:bg-cream transition-colors">{t(ui, 'view_menu', lang)} <Chevron /></a>
          </div>
        </div>
      </div>
    </div>

    <div aria-hidden="true" class="m-ribbon-draw absolute inset-x-0 bottom-6 h-12 bg-maroon border-y-4 border-kahk/60 flex items-center overflow-hidden whitespace-nowrap text-cream font-display text-xl">
      <!-- Phones: the text stops short of the end so the small logo seal sits on plain ribbon. -->
      <span class="block min-w-0 flex-1 overflow-hidden max-md:me-14">
        <span class="m-ribbon-scroll inline-flex w-max"><span>{ribbon}</span><span>{ribbon}</span></span>
      </span>
    </div>
    <img src={brand.logo} alt="" aria-hidden="true" width="118" height="118"
      class="m-knot-settle absolute bottom-7 end-2 size-10 ring-2 md:bottom-0 md:end-12 md:size-24 md:ring-4 rounded-full ring-maroon" />
  </section>

  <!-- Seasonal -->
  <section class="bg-maroon-deep text-cream">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
        <h2 class="font-display text-5xl">{t(season, 'title', lang)}</h2>
        <ul class="flex flex-wrap gap-2">
          {t(season, 'subcategories', lang).map((s) => <li class="border border-rose/50 text-rose px-3 py-1">{s}</li>)}
        </ul>
        <a href={localizeHref('/seasonal', lang)} class="md:ms-auto inline-flex items-center min-h-11 font-semibold underline underline-offset-4 hover:text-rose">{t(h, 'seasonal_cta', lang)} <Chevron /></a>
      </div>
      <ul class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-5">
        {/* 5 cards: the first spans 2 columns below lg, so 2 and 3 columns fill with no orphan. */}
        {season.products.map((p, i) => <li class:list={["text-cream [&_h3]:text-cream [&_p]:text-rose [&_a]:text-rose [&_article]:border-rose/30 [&_button]:bg-rose [&_button]:text-maroon-deep [&_button]:hover:bg-cream [&_button]:hover:text-maroon-deep", { "col-span-2 lg:col-span-1": i === 0 }]}><ProductCard p={p} lang={lang} float={p.float === true} wide={i === 0} /></li>)}
      </ul>
    </div>
  </section>

  <!-- Categories -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="font-display text-maroon text-4xl md:text-5xl">{t(h, 'categories_h', lang)}</h2>
    <!-- Phones: 2 columns of compact 2:1 tiles; md+: 5 columns of 3:2 tiles. 10 categories fill both evenly. -->
    <ul class="mt-6 md:mt-8 grid grid-cols-2 md:grid-cols-5 gap-x-3 gap-y-3 md:gap-4">
      {site.categories.map((c) => (
        <li>
          <a href={localizeHref(`/menu/${c.slug}`, lang)} class="group block min-h-11">
            {!c.img && productImg(c.slug)
              ? <span class="block bg-rose">
                  <img src={productImg(c.slug)} alt="" loading="lazy" width="415" height="415" class:list={["aspect-[2/1] md:aspect-[3/2]", "w-full object-contain mix-blend-multiply"]} />
                </span>
              : c.img
              ? <span class="relative block">
                  <img src={c.img} alt="" loading="lazy" width="450" height="300" class:list={["aspect-[2/1] md:aspect-[3/2]", "w-full object-cover"]} />
                  {c.steam && (
                    <span aria-hidden="true" class="absolute inset-x-0 top-0 h-1/3 pointer-events-none">
                      <span aria-hidden="true" class="m-steam absolute start-1/3 bottom-0 w-4 h-10 rounded-full bg-cream/70 blur-sm"></span>
                      <span aria-hidden="true" class="m-steam absolute start-1/2 bottom-0 w-4 h-10 rounded-full bg-cream/70 blur-sm"></span>
                      <span aria-hidden="true" class="m-steam absolute start-2/3 bottom-0 w-4 h-10 rounded-full bg-cream/70 blur-sm"></span>
                    </span>
                  )}
                </span>
              : <span aria-hidden="true" class:list={["aspect-[2/1] md:aspect-[3/2]", "w-full bg-rose grid place-items-center font-display text-maroon text-3xl"]}>{label(c, lang)}</span>}
            <span class="mt-1 md:mt-2 block text-sm leading-tight md:text-base md:leading-relaxed font-semibold group-hover:text-maroon group-hover:underline underline-offset-4">{label(c, lang)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Best sellers shelf -->
  <section class="mx-auto max-w-6xl px-4">
    <h2 class="font-display text-maroon text-4xl md:text-5xl">{t(h, 'best_h', lang)}</h2>
    <div data-shelf class="mt-8 overflow-x-auto pb-4 max-md:-mx-4 max-md:px-4 max-md:scroll-px-4 max-md:snap-x max-md:snap-mandatory">
      <div class="m-marquee flex w-max">
        <ul class="flex gap-4 md:gap-5 md:pe-5">
          {site.best_sellers.map((p) => <li class="shrink-0 w-[40vw] sm:w-44 md:w-52 max-md:snap-start"><ProductCard p={p} lang={lang} /></li>)}
        </ul>
        <ul data-marquee-copy aria-hidden="true" inert class="flex gap-4 md:gap-5 md:pe-5">
          {site.best_sellers.map((p) => <li class="shrink-0 w-44 md:w-52"><ProductCard p={p} lang={lang} /></li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Heritage as a spec sheet: the founding year huge, then the real story years one line each. -->
  <section class="mx-auto max-w-6xl px-4 pt-20 pb-6">
    <div aria-hidden="true" class="m-draw-in h-3 bg-maroon border-y-2 border-kahk/60"></div>
    <div class="mt-10 grid gap-6 md:grid-cols-[auto_1fr] md:gap-16 items-start">
      <p aria-hidden="true" class="font-display text-maroon leading-[0.8] text-[30vw] md:text-[11rem] lg:text-[13rem]">{num(brand.since, lang)}</p>
      <div>
        <h2 class="font-display text-maroon text-4xl md:text-5xl">{t(h, 'heritage_h', lang)}</h2>
        <p class="mt-3 max-w-2xl text-lg">{t(h, 'heritage_p', lang)}</p>
        <ol class="mt-8 border-t border-dotted border-maroon/50">
          {site.story.map((e) => (
            <li class="grid grid-cols-[4rem_1fr] md:grid-cols-[5rem_1fr] gap-4 py-3 border-b border-dotted border-maroon/50">
              <span class="font-display text-maroon text-2xl leading-tight">{num(e.year, lang)}</span>
              <span>{label(e, lang)}</span>
            </li>
          ))}
        </ol>
        <a href={localizeHref('/story', lang)} class="mt-4 inline-flex items-center min-h-11 font-semibold text-maroon underline underline-offset-4">{t(h, 'heritage_cta', lang)} <Chevron /></a>
      </div>
    </div>
  </section>

  <!-- Branches teaser -->
  <section class="mx-auto max-w-6xl px-4 pt-16">
    <h2 class="font-display text-maroon text-4xl md:text-5xl">{t(h, 'branches_h', lang)}</h2>
    <!-- One full-width tappable row per branch, opening its map search. -->
    <ul class="mt-6 grid md:grid-cols-3 md:gap-x-8 border-t border-maroon/20">
      {site.branches_ar.map((bAr, i) => (
        <li class="border-b border-maroon/20">
          <a href={mapUrl(bAr)} rel="noopener" class="flex items-center justify-between gap-3 min-h-11 py-2 text-lg hover:text-maroon">
            <span>{t(site, 'branches', lang)[i]}</span>{' '}
            <span class="flex items-center gap-1 text-sm font-semibold text-maroon">{t(ui, 'map_link', lang)} <Chevron /></span>
          </a>
        </li>
      ))}
    </ul>
    <a href={localizeHref('/branches', lang)} class="mt-8 inline-flex items-center min-h-11 font-semibold text-maroon underline underline-offset-4">{t(h, 'branches_cta', lang)} <Chevron /></a>
  </section>

  <!-- Closing: the primary action again, as big as the hero. -->
  <!-- -mb-20 cancels the footer's top margin so the two dark blocks meet; a hairline separates them. -->
  <section class="mt-20 -mb-20 border-b border-rose/20 bg-maroon-deep text-cream overflow-x-clip">
    <div aria-hidden="true" class="m-draw-in h-3 bg-maroon border-b-2 border-kahk/60"></div>
    <div class="mx-auto max-w-6xl px-4 pt-14 pb-16 md:pt-20 md:pb-24">
      <h2 class="font-display text-rose text-3xl md:text-5xl">
        {t(ui, 'order', lang)}
        <a href={`tel:${contact.hotline}`} class="mt-2 block w-fit min-h-11 text-cream leading-[0.85] text-[30vw] md:text-[15rem] hover:text-rose transition-colors">{num(contact.hotline, lang)}</a>
      </h2>
      <p {...openStatus} class="mt-8 font-semibold text-rose">
        <span aria-hidden="true" class="open-dot inline-block align-middle size-2 me-1.5 rounded-full bg-rose"></span>
        <span data-open-text>{orderHours}</span>
      </p>
    </div>
  </section>
  <script>import '../../scripts/shelf-touch.js';</script>
  <script>import '../../scripts/open-status.js';</script>
</Layout>
