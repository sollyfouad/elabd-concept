---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Chevron from '../../components/Chevron.astro';
import site from '../../data/site.json';
import { t, num, label } from '../../lib/format.js';
import { localizeHref } from '../../lib/i18n.js';

const { lang } = Astro.props;
const { ui, brand, contact } = site;
const h = ui.home;
const season = site.seasonal[site.seasonal.active];
const ribbon = `${t(brand, 'tagline', lang)} · ${t(ui, 'since', lang)} ${num(brand.since, lang)} · `;
---
<Layout title={t(ui.pages.home, 'title', lang)} description={t(ui.pages.home, 'description', lang)} lang={lang}>
  <!-- The box lid: rose panel, maroon ribbon, logo on the knot -->
  <section class="relative overflow-hidden bg-rose">
    <div aria-hidden="true" class="absolute inset-y-0 end-6 md:end-24 w-10 md:w-14 bg-maroon border-x-4 border-kahk/60"></div>
    <div aria-hidden="true" class="absolute inset-x-0 bottom-6 h-12 bg-maroon border-y-4 border-kahk/60 flex items-center overflow-hidden whitespace-nowrap text-cream font-display text-xl">
      {ribbon.repeat(12)}
    </div>
    <img src={brand.logo} alt="" aria-hidden="true" width="118" height="118"
      class="absolute bottom-0 end-1 md:end-19 size-22 md:size-24 rounded-full ring-4 ring-maroon" />
    <div class="relative mx-auto max-w-6xl px-4 pt-14 pb-32 md:pt-24 md:pb-40 pe-20 md:pe-48">
      <h1 class="font-display text-maroon text-5xl sm:text-6xl md:text-8xl leading-[1.3] max-w-3xl">{t(brand, 'hero', lang)}</h1>
      <p class="mt-6 max-w-xl text-lg">{t(h, 'intro', lang)}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`tel:${contact.hotline}`} class="bg-maroon text-cream font-semibold text-lg px-6 py-3 hover:bg-maroon-deep transition-colors">{t(ui, 'order', lang)} {num(contact.hotline, lang)}</a>
        <a href={localizeHref('/menu', lang)} class="border-2 border-maroon text-maroon font-semibold text-lg px-6 py-3 hover:bg-cream transition-colors">{t(ui, 'view_menu', lang)} <Chevron /></a>
      </div>
    </div>
  </section>

  <!-- Seasonal -->
  <section class="bg-maroon-deep text-cream">
    <div class="mx-auto max-w-6xl px-4 py-14 grid gap-10 md:grid-cols-[1fr_2fr] items-start">
      <div>
        <h2 class="font-display text-5xl">{t(season, 'title', lang)}</h2>
        <ul class="mt-5 flex flex-wrap gap-2">
          {t(season, 'subcategories', lang).map((s) => <li class="border border-rose/50 text-rose px-3 py-1">{s}</li>)}
        </ul>
        <a href={localizeHref('/seasonal', lang)} class="mt-6 inline-block font-semibold underline underline-offset-4 hover:text-rose">{t(h, 'seasonal_cta', lang)} <Chevron /></a>
      </div>
      <ul class="grid grid-cols-2 gap-5">
        {season.products.map((p) => <li class="text-cream [&_h3]:text-cream [&_p]:text-rose [&_a]:text-rose [&_article]:border-rose/30"><ProductCard p={p} lang={lang} /></li>)}
      </ul>
    </div>
  </section>

  <!-- Categories -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="font-display text-maroon text-4xl md:text-5xl">{t(h, 'categories_h', lang)}</h2>
    <ul class="mt-8 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {site.categories.map((c) => (
        <li>
          <a href={localizeHref(`/menu/${c.slug}`, lang)} class="group block">
            {c.img
              ? <img src={c.img} alt="" loading="lazy" width="450" height="300" class="aspect-[3/2] w-full object-cover" />
              : <span aria-hidden="true" class="aspect-[3/2] w-full bg-rose grid place-items-center font-display text-maroon text-3xl">{label(c, lang)}</span>}
            <span class="mt-2 block font-semibold group-hover:text-maroon group-hover:underline underline-offset-4">{label(c, lang)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Best sellers shelf -->
  <section class="mx-auto max-w-6xl px-4">
    <h2 class="font-display text-maroon text-4xl md:text-5xl">{t(h, 'best_h', lang)}</h2>
    <ul class="mt-8 flex gap-5 overflow-x-auto snap-x pb-4">
      {site.best_sellers.map((p) => <li class="snap-start shrink-0 w-44 md:w-52"><ProductCard p={p} lang={lang} /></li>)}
    </ul>
  </section>

  <!-- Heritage -->
  <section class="mx-auto max-w-6xl px-4 py-16 mt-10 border-y-2 border-kahk/50 grid gap-6 md:grid-cols-[auto_1fr] items-center">
    <p aria-hidden="true" class="font-display text-maroon text-8xl md:text-9xl leading-none">{num(brand.since, lang)}</p>
    <div>
      <h2 class="font-display text-maroon text-4xl">{t(h, 'heritage_h', lang)}</h2>
      <p class="mt-3 max-w-2xl text-lg">{t(h, 'heritage_p', lang)}</p>
      <a href={localizeHref('/story', lang)} class="mt-4 inline-block font-semibold text-maroon underline underline-offset-4">{t(h, 'heritage_cta', lang)} <Chevron /></a>
    </div>
  </section>

  <!-- Branches teaser -->
  <section class="mx-auto max-w-6xl px-4 pt-16">
    <h2 class="font-display text-maroon text-4xl md:text-5xl">{t(h, 'branches_h', lang)}</h2>
    <ul class="mt-6 flex flex-wrap gap-x-2 gap-y-3 text-lg">
      {t(site, 'branches', lang).map((b, i) => <li>{b}{i < t(site, 'branches', lang).length - 1 && <span aria-hidden="true" class="text-kahk ms-2">◆</span>}</li>)}
    </ul>
    <div class="mt-8 flex flex-wrap gap-6 items-center">
      <a href={localizeHref('/branches', lang)} class="font-semibold text-maroon underline underline-offset-4">{t(h, 'branches_cta', lang)} <Chevron /></a>
      <p>{t(ui, 'hotline_label', lang)}: <a href={`tel:${contact.hotline}`} class="font-semibold text-maroon">{num(contact.hotline, lang)}</a></p>
    </div>
  </section>
</Layout>
