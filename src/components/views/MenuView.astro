---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Chevron from '../../components/Chevron.astro';
import site from '../../data/site.json';
import { allProducts, t, label } from '../../lib/format.js';
import { localizeHref } from '../../lib/i18n.js';

const { lang } = Astro.props;
const pg = site.ui.pages.menu;
---
<Layout title={t(pg, 'title', lang)} description={t(pg, 'description', lang)} lang={lang}>
  <div class="mx-auto max-w-6xl px-4 pt-12">
    <h1 class="font-display text-maroon text-6xl">{t(pg, 'h1', lang)}</h1>
    <p class="mt-3 text-lg">{t(pg, 'intro', lang)}</p>
  </div>
  <nav aria-label={t(site.ui, 'menu_sections_label', lang)} class="sticky top-14 md:top-0 z-30 bg-cream/95 border-b border-maroon/15 mt-8">
    <ul class="mx-auto max-w-6xl px-4 flex gap-2 overflow-x-auto py-3">
      {site.categories.map((c) => <li class="shrink-0"><a href={`#${c.slug}`} class="flex items-center min-h-11 border border-maroon/40 px-3 py-1 text-maroon font-semibold hover:bg-rose">{label(c, lang)}</a></li>)}
    </ul>
  </nav>
  <div class="mx-auto max-w-6xl px-4">
    {site.categories.map((c) => {
      const products = allProducts.filter((p) => p.category === c.slug);
      const sub = t(c, 'sub', lang);
      return (
        <section id={c.slug} class="scroll-mt-32 md:scroll-mt-20 py-12 border-b border-maroon/15">
          <h2 class="font-display text-maroon text-4xl">{label(c, lang)}</h2>
          {sub.length > 0 && <p class="mt-3 text-qahwa/80">{sub.join(' · ')}</p>}
          {products.length > 0 &&
            <ul class="mt-6 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-5">
              {products.map((p) => <li><ProductCard p={p} lang={lang} /></li>)}
            </ul>}
          <a href={localizeHref(`/menu/${c.slug}`, lang)} class="mt-6 inline-flex items-center min-h-11 font-semibold text-maroon underline underline-offset-4">{t(site.ui, 'view_category', lang)} {label(c, lang)} <Chevron /></a>
        </section>
      );
    })}
  </div>
</Layout>
