---
import Layout from '../../layouts/Layout.astro';
import site from '../../data/site.json';
import { t, num, label } from '../../lib/format.js';
const { lang } = Astro.props;
const pg = site.ui.pages.story;
---
<Layout title={t(pg, 'title', lang)} description={t(pg, 'description', lang)} lang={lang}>
  <div class="mx-auto max-w-3xl px-4 pt-12">
    <h1 class="font-display text-maroon text-6xl">{t(pg, 'h1', lang)}</h1>
    <p class="mt-3 text-lg">{t(pg, 'intro', lang)}</p>
    <!-- A real sequence, so a numbered timeline is fine here -->
    <ol class="mt-12 border-s-4 border-kahk">
      {site.story.map((s) => (
        <li class="relative ps-8 pb-12 last:pb-0">
          <span aria-hidden="true" class="absolute -start-[14px] top-3 size-6 rounded-full bg-maroon ring-4 ring-cream"></span>
          <h2 class="font-display text-maroon text-5xl"><time datetime={String(s.year)}>{num(s.year, lang)}</time></h2>
          <p class="mt-2 text-lg">{label(s, lang)}</p>
        </li>
      ))}
    </ol>
  </div>
</Layout>
